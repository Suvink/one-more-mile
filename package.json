{
  "name": "one-more-mile",
  "version": "1.0.0",
  "description": "One More Mile: voice messages for marathon runners, built on Twilio Serverless",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "npm install --no-audit --no-fund && node setup.mjs",
    "destroy": "node destroy.mjs",
    "start": "twilio-run start"
  },
  "dependencies": {
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "twilio-run": "^4.2.0"
  }
}
